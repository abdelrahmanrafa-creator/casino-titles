{
  "name": "casino-and-titles",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "npm run i18n:check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180",
    "test": "node --test tests/*.test.mjs",
    "catalog:generate": "node scripts/catalog.mjs",
    "smoke": "node scripts/smoke.mjs",
    "i18n:build": "node scripts/i18n-build.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "build:native": "npm run i18n:check && tsc --noEmit && vite build --mode native --outDir dist-native",
    "app:windows": "node scripts/native-build.mjs windows",
    "app:android": "node scripts/native-build.mjs android",
    "app:sync": "node scripts/native-build.mjs sync",
    "app:doctor": "node scripts/native-build.mjs doctor",
    "app:icons": "node scripts/native-icons.mjs && capacitor-assets generate --assetPath resources --iconBackgroundColor \"#0d0b14\" --splashBackgroundColor \"#0d0b14\" --android --ios",
    "app:ios": "bash scripts/build-ios.sh",
    "app:desktop": "npm run build:native && node scripts/bundle-desktop.mjs && node node_modules/electron/install.js && electron desktop/main.bundle.cjs",
    "app:publish": "node scripts/publish-apps.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.5",
    "electron-updater": "6.8.11",
    "framer-motion": "^14.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "^0.5.10",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.12.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.7"
  },
  "description": "Casino & Titles desktop and mobile application",
  "author": "Casino & Titles"
}
